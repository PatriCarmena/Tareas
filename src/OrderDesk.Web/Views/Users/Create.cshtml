@model CreateUserVm
@{ ViewData["Title"] = "Nuevo usuario"; }
<div class="narrow"><a class="back" asp-action="Index">← Usuarios</a><form method="post" class="form-card"><h1>Nuevo usuario</h1><div asp-validation-summary="ModelOnly" class="validation"></div><div class="field"><label asp-for="FullName">Nombre completo</label><input asp-for="FullName"/></div><div class="field-row"><div class="field"><label asp-for="Email"></label><input asp-for="Email"/></div><div class="field"><label asp-for="PhoneNumber">WhatsApp</label><input asp-for="PhoneNumber" placeholder="+549..."/></div></div><div class="field"><label asp-for="Password">Contraseña temporal</label><input asp-for="Password"/></div><div class="field"><label asp-for="Role">Rol</label><select asp-for="Role">@foreach (var role in AppRoles.All) { <option>@role</option> }</select></div><div class="form-actions"><a class="button button-secondary" asp-action="Index">Cancelar</a><button class="button">Crear</button></div></form></div>
