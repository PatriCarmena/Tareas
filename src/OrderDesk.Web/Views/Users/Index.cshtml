@model IReadOnlyList<UserListItemVm>
@{ ViewData["Title"] = "Usuarios"; }
<section class="page-heading"><div><p class="eyebrow">ADMINISTRACIÓN</p><h1>Usuarios y roles</h1></div><a class="button" asp-action="Create">+ Nuevo usuario</a></section><div class="panel table-wrap"><table><thead><tr><th>Usuario</th><th>Contacto</th><th>Rol</th><th>Acciones</th></tr></thead><tbody>@foreach (var user in Model) { <tr><td><strong>@user.FullName</strong><small>@user.Email</small></td><td>@(user.Phone ?? "Sin teléfono")</td><td><span class="status">@user.Role</span></td><td><div class="user-actions"><a class="button button-secondary button-small" asp-action="Edit" asp-route-id="@user.Id">Editar</a><form asp-action="Delete" method="post" onsubmit="return confirm('Se eliminará este usuario de forma permanente. ¿Deseás continuar?');"><input type="hidden" name="id" value="@user.Id"/><button class="button button-danger button-small" type="submit">Eliminar</button></form></div></td></tr> }</tbody></table></div>
