@model IReadOnlyList<UserListItemVm>
@{ ViewData["Title"] = "Usuarios"; }
<section class="page-heading"><div><p class="eyebrow">ADMINISTRACIÓN</p><h1>Usuarios y roles</h1></div><a class="button" asp-action="Create">+ Nuevo usuario</a></section><div class="panel table-wrap"><table><thead><tr><th>Usuario</th><th>Contacto</th><th>Rol</th></tr></thead><tbody>@foreach (var user in Model) { <tr><td><strong>@user.FullName</strong><small>@user.Email</small></td><td><form asp-action="ChangePhone" method="post" class="inline-form"><input type="hidden" name="id" value="@user.Id"/><input type="tel" name="phoneNumber" value="@user.Phone" placeholder="+549..." aria-label="WhatsApp de @user.Email"/><button class="button button-secondary">Guardar</button></form></td><td><form asp-action="ChangeRole" method="post" class="inline-form"><input type="hidden" name="id" value="@user.Id"/><select name="role">@foreach (var role in AppRoles.All) { <option value="@role" selected="@(role == user.Role)">@role</option> }</select><button class="button button-secondary">Guardar</button></form></td></tr> }</tbody></table></div>
