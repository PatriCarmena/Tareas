@model ForgotPasswordVm
@{ ViewData["Title"] = "Recuperar contraseña"; }
<section class="auth-card"><p class="eyebrow">SEGURIDAD</p><h1>Recuperar contraseña</h1><p class="subtle">Si tu usuario tiene un teléfono asociado, recibirás un código por WhatsApp.</p><form method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="field"><label asp-for="Email"></label><input asp-for="Email"/><span asp-validation-for="Email"></span></div><button class="button full">Enviar código</button></form><a class="text-link" asp-action="Login">Volver al ingreso</a></section>
