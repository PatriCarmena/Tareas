@model ResetPasswordVm
@{ ViewData["Title"] = "Nueva contraseña"; }
<section class="auth-card"><p class="eyebrow">SEGURIDAD</p><h1>Nueva contraseña</h1><form method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="field"><label asp-for="Email"></label><input asp-for="Email"/></div><div class="field"><label asp-for="Code">Código de 6 dígitos</label><input asp-for="Code" inputmode="numeric"/><span asp-validation-for="Code"></span></div><div class="field"><label asp-for="NewPassword">Nueva contraseña</label><input asp-for="NewPassword"/><span asp-validation-for="NewPassword"></span></div><div class="field"><label asp-for="ConfirmPassword">Repetir contraseña</label><input asp-for="ConfirmPassword"/><span asp-validation-for="ConfirmPassword"></span></div><button class="button full">Guardar contraseña</button></form></section>
