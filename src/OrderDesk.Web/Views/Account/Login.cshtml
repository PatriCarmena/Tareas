@model LoginVm
@{ ViewData["Title"] = "Iniciar sesión"; }
<section class="auth-card"><div><p class="eyebrow">BIENVENIDO</p><h1>Iniciar sesión</h1><p class="subtle">Accedé a la gestión de Nexo.</p></div><form method="post"><input asp-for="ReturnUrl" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation"></div><div class="field"><label asp-for="Email"></label><input asp-for="Email" autocomplete="email"/><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="Password">Contraseña</label><div class="password-field"><input asp-for="Password" autocomplete="current-password"/><button type="button" class="password-toggle" aria-label="Mostrar contraseña" title="Mostrar contraseña">👁</button></div><span asp-validation-for="Password"></span></div><label class="check"><input asp-for="RememberMe"/> Recordarme</label><button class="button full" type="submit">Ingresar</button></form><a class="text-link" asp-action="ForgotPassword">¿Olvidaste tu contraseña?</a><div class="separator">o</div><a class="button button-secondary full" asp-action="GoogleLogin" asp-route-returnUrl="@Model.ReturnUrl">Continuar con Google</a></section>
