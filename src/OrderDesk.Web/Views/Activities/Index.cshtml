@model ActivityListVm
@{ ViewData["Title"] = "Actividades"; var canEdit = User.IsInRole(AppRoles.Administrator) || User.IsInRole(AppRoles.Operator); }
<section class="page-heading"><div><p class="eyebrow">SEGUIMIENTO</p><h1>Actividades</h1><p class="subtle">Llamadas, correos, reuniones y tareas de todos los clientes.</p></div></section>
<form method="get" class="activity-filters"><label class="search"><span aria-hidden="true">⌕</span><input name="query" value="@Model.Query" placeholder="Buscar actividad o cliente" aria-label="Buscar actividad o cliente" /></label>
    <select name="type" aria-label="Tipo de actividad"><option value="">Todos los tipos</option>@foreach (var type in Enum.GetValues<ActivityType>()) { <option value="@type" selected="@(Model.Type == type)">@ActivitySchedule.TypeLabel(type)</option> }</select>
    <select name="status" aria-label="Estado"><option value="">Todos los estados</option><option value="today" selected="@(Model.Status == "today")">Hoy</option><option value="pending" selected="@(Model.Status == "pending")">Pendientes</option><option value="overdue" selected="@(Model.Status == "overdue")">Vencidas</option><option value="completed" selected="@(Model.Status == "completed")">Realizadas</option></select>
    <label class="mine-check"><input type="checkbox" name="mine" value="true" checked="@Model.Mine" /> Solo las mías</label><button class="button button-secondary" type="submit">Filtrar</button><a class="text-link" asp-action="Index">Limpiar</a>
</form>
@if (Model.Activities.Count == 0) { <div class="empty compact"><h2>No hay actividades con estos filtros</h2><p>Probá otra búsqueda o programá una desde la ficha de un cliente.</p></div> }
else { <div class="panel table-wrap"><table><thead><tr><th>Actividad</th><th>Cliente</th><th>Programada</th><th>Responsable</th><th>Prioridad</th><th>Estado</th>@if (canEdit) { <th>Acciones</th> }</tr></thead><tbody>
    @foreach (var activity in Model.Activities) { <tr><td><strong>@activity.Title</strong><small>@ActivitySchedule.TypeLabel(activity.Type)</small></td><td><a class="text-link" asp-controller="Customers" asp-action="Details" asp-route-id="@activity.CustomerId">@activity.Customer.Name</a></td><td>@ActivitySchedule.ToLocal(activity.ScheduledAtUtc).ToString("dd/MM/yyyy HH:mm")</td><td>@(activity.AssignedUser?.FullName ?? "Sin asignar")</td><td><span class="priority priority-@activity.Priority.ToString().ToLowerInvariant()">@ActivitySchedule.PriorityLabel(activity.Priority)</span></td><td><span class="activity-state state-@ActivitySchedule.EffectiveStatus(activity, DateTime.UtcNow).ToLowerInvariant()">@ActivitySchedule.EffectiveStatus(activity, DateTime.UtcNow)</span></td>@if (canEdit) { <td>@if (activity.Status == ActivityStatus.Pending) { <div class="activity-table-actions"><a class="text-link" asp-action="Edit" asp-route-id="@activity.Id">Editar</a><form asp-action="Complete" asp-route-id="@activity.Id" method="post" data-confirm-submit="¿Marcar esta actividad como realizada?"><button class="button button-small button-secondary" type="submit">Realizada</button></form></div> }</td> }</tr> }
</tbody></table></div> }
@if (Model.TotalPages > 1) { <nav class="pagination" aria-label="Paginación"><a class="button button-secondary @(Model.Page == 1 ? "disabled" : "")" asp-route-page="@(Model.Page - 1)" asp-route-query="@Model.Query" asp-route-type="@Model.Type" asp-route-status="@Model.Status" asp-route-mine="@Model.Mine">← Anterior</a><span>Página @Model.Page de @Model.TotalPages</span><a class="button button-secondary @(Model.Page == Model.TotalPages ? "disabled" : "")" asp-route-page="@(Model.Page + 1)" asp-route-query="@Model.Query" asp-route-type="@Model.Type" asp-route-status="@Model.Status" asp-route-mine="@Model.Mine">Siguiente →</a></nav> }
