@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var userName = User.Identity?.Name;
    var userInitial = string.IsNullOrWhiteSpace(userName) ? "N" : userName[..1].ToUpperInvariant();
}
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Nexo</title>
    <meta name="description" content="Nexo · Gestión comercial, clientes y pedidos" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/features.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dialogs.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/crm.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/activities.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/opportunities.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/automation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>
<body class="@(signedIn ? "app-page" : "auth-page")">
    <svg class="icon-library" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <symbol id="icon-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></symbol>
        <symbol id="icon-people" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3.5 20v-2a5.5 5.5 0 0 1 11 0v2zM17 5a3 3 0 0 1 0 6M17 14a5 5 0 0 1 4 5v1h-3"/></symbol>
        <symbol id="icon-box" viewBox="0 0 24 24"><path d="m3 7 9-4 9 4v10l-9 4-9-4zM3 7l9 4 9-4M12 11v10"/></symbol>
        <symbol id="icon-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4M17 3v4M3 10h18m-13 5h3"/></symbol>
        <symbol id="icon-target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></symbol>
        <symbol id="icon-chart" viewBox="0 0 24 24"><path d="M4 20V4M4 20h17M8 16l4-5 3 2 5-7"/></symbol>
        <symbol id="icon-users" viewBox="0 0 24 24"><circle cx="8" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M2.5 20v-2a5.5 5.5 0 0 1 11 0v2zM15 16a4.5 4.5 0 0 1 6.5 4H16"/></symbol>
        <symbol id="icon-exit" viewBox="0 0 24 24"><path d="M10 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h5M14 8l4 4-4 4M8 12h10"/></symbol>
    </svg>
    @if (signedIn)
    {
        <div class="app-frame">
            <aside class="app-sidebar" aria-label="Navegación principal">
                <a class="sidebar-brand" asp-controller="Dashboard" asp-action="Index" aria-label="Nexo, inicio"><span class="brand-mark">N</span><span class="brand-copy"><strong>Nexo</strong><small>Espacio comercial</small></span></a>
                <div class="sidebar-section-label">ESPACIO DE TRABAJO</div>
                <nav class="sidebar-nav">
                    <a class="nav-item @(controller == "Dashboard" ? "is-active" : "")" asp-controller="Dashboard" asp-action="Index" aria-current="@(controller == "Dashboard" ? "page" : null)"><svg><use href="#icon-grid" /></svg>Dashboard</a>
                    <a class="nav-item @(controller == "Customers" ? "is-active" : "")" asp-controller="Customers" asp-action="Index" aria-current="@(controller == "Customers" ? "page" : null)"><svg><use href="#icon-people" /></svg>Clientes</a>
                    <a class="nav-item @(controller == "Orders" ? "is-active" : "")" asp-controller="Orders" asp-action="Index" aria-current="@(controller == "Orders" ? "page" : null)"><svg><use href="#icon-box" /></svg>Pedidos</a>
                    <a class="nav-item @(controller == "Activities" ? "is-active" : "")" asp-controller="Activities" asp-action="Index" aria-current="@(controller == "Activities" ? "page" : null)"><svg><use href="#icon-calendar" /></svg>Actividades</a>
                    <a class="nav-item @(controller == "Opportunities" ? "is-active" : "")" asp-controller="Opportunities" asp-action="Index" aria-current="@(controller == "Opportunities" ? "page" : null)"><svg><use href="#icon-target" /></svg>Oportunidades</a>
                    @if (User.IsInRole(AppRoles.Administrator))
                    {
                        <div class="sidebar-section-label sidebar-section-label-secondary">ADMINISTRACIÓN</div>
                        <a class="nav-item @(controller == "Reports" ? "is-active" : "")" asp-controller="Reports" asp-action="Index" aria-current="@(controller == "Reports" ? "page" : null)"><svg><use href="#icon-chart" /></svg>Informes</a>
                        <a class="nav-item @(controller == "Users" ? "is-active" : "")" asp-controller="Users" asp-action="Index" aria-current="@(controller == "Users" ? "page" : null)"><svg><use href="#icon-users" /></svg>Usuarios</a>
                    }
                </nav>
                <div class="sidebar-footer"><div class="user-avatar" aria-hidden="true">@userInitial</div><div class="sidebar-user"><strong>@userName</strong><small>Sesión activa</small></div><form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="logout-button" title="Cerrar sesión" aria-label="Cerrar sesión"><svg><use href="#icon-exit" /></svg></button></form></div>
            </aside>
            <div class="app-content">
                <header class="workspace-header"><div><span class="workspace-label">NEXO / ESPACIO DE TRABAJO</span><strong>@ViewData["Title"]</strong></div><span class="workspace-pill"><span></span> Gestión en línea</span></header>
                <main class="shell app-shell">
                    @if (TempData["Success"] is string success) { <div class="toast" role="status"><span aria-hidden="true">✓</span> @success</div> }
                    @if (TempData["Error"] is string error) { <div class="toast toast-error" role="alert"><span aria-hidden="true">!</span> @error</div> }
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <header class="auth-header"><a class="sidebar-brand" asp-controller="Dashboard" asp-action="Index" aria-label="Nexo, inicio"><span class="brand-mark">N</span><span class="brand-copy"><strong>Nexo</strong><small>Espacio comercial</small></span></a></header>
        <main class="shell auth-shell">
            @if (TempData["Success"] is string success) { <div class="toast" role="status"><span aria-hidden="true">✓</span> @success</div> }
            @if (TempData["Error"] is string error) { <div class="toast toast-error" role="alert"><span aria-hidden="true">!</span> @error</div> }
            @RenderBody()
        </main>
    }
    <dialog id="confirm-dialog" class="confirm-dialog" aria-labelledby="confirm-title" aria-describedby="confirm-message"><form method="dialog"><p class="eyebrow">CONFIRMACIÓN</p><h2 id="confirm-title">Confirmar acción</h2><p id="confirm-message"></p><div class="form-actions"><button class="button button-secondary" value="cancel">Cancelar</button><button class="button" value="confirm">Confirmar</button></div></form></dialog>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
