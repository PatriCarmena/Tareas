@model ReportVm
@using System.Globalization
@{ ViewData["Title"] = "Informes"; var money = CultureInfo.GetCultureInfo("es-AR"); }
<section class="page-heading"><div><p class="eyebrow">ADMINISTRACIÓN · ETAPA 5</p><h1>Informes y métricas</h1><p class="subtle">Ventas, oportunidades y seguimiento basados en los datos registrados en Nexo.</p></div></section>
<form method="get" class="panel report-filters"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="field"><label for="from">Desde</label><input id="from" name="from" type="date" value="@Model.From.ToString("yyyy-MM-dd")" required /></div><div class="field"><label for="to">Hasta</label><input id="to" name="to" type="date" value="@Model.To.ToString("yyyy-MM-dd")" required /></div><div class="field"><label for="salespersonId">Vendedor / responsable</label><select id="salespersonId" name="salespersonId"><option value="">Todos</option>@foreach (var seller in Model.Sellers) { <option value="@seller.Id" selected="@(seller.Id == Model.SalespersonId)">@seller.FullName</option> }</select></div><button class="button" type="submit">Aplicar filtros</button></form>
<div class="report-export"><span>Descargar CSV para Excel:</span><a class="button button-secondary button-small" asp-action="Export" asp-route-kind="sales" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-salespersonId="@Model.SalespersonId">Ventas</a><a class="button button-secondary button-small" asp-action="Export" asp-route-kind="opportunities" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-salespersonId="@Model.SalespersonId">Oportunidades</a><a class="button button-secondary button-small" asp-action="Export" asp-route-kind="activities" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-salespersonId="@Model.SalespersonId">Actividades</a><a class="button button-secondary button-small" asp-action="Export" asp-route-kind="customers" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-salespersonId="@Model.SalespersonId">Clientes sin contacto</a></div>
<div class="report-kpis"><div class="metric"><span>Pedidos no cancelados</span><strong>@Model.SalesOrders.Count</strong></div><div class="metric accent"><span>Monto de ventas</span><strong>@Model.SalesTotal.ToString("C0", money)</strong></div><div class="metric"><span>Conversión de oportunidades</span><strong>@Model.ConversionRate.ToString("0.0", money)%</strong><small>@Model.WonCount ganadas / @(Model.WonCount + Model.LostCount) cerradas</small></div><div class="metric"><span>Tiempo medio de cierre</span><strong>@(Model.AverageCloseDays?.ToString("0.0", money) ?? "—") @(Model.AverageCloseDays.HasValue ? "días" : "")</strong><small>@Model.CloseSampleCount ventas con fecha registrada</small></div></div>
<p class="report-note">El período se aplica a la fecha de creación de pedidos y oportunidades. La conversión compara oportunidades ganadas con ganadas + perdidas de esa cohorte; no cuenta las todavía abiertas. Se excluyen pedidos cancelados. Las actividades y los clientes sin contacto son una foto del estado actual, independiente del período.</p>
<div class="report-columns"><section class="panel"><div class="panel-title"><div><p class="eyebrow">VENTAS</p><h2>Por día</h2></div></div>@if (Model.SalesByPeriod.Count == 0) { <p class="subtle">No hay pedidos no cancelados en el período.</p> }<div class="table-wrap"><table><thead><tr><th>Fecha</th><th>Pedidos</th><th>Monto</th></tr></thead><tbody>@foreach (var row in Model.SalesByPeriod) { <tr><td>@row.Day.ToString("dd/MM/yyyy")</td><td>@row.Count</td><td>@row.Total.ToString("C0", money)</td></tr> }</tbody></table></div></section>
<section class="panel"><div class="panel-title"><div><p class="eyebrow">EQUIPO</p><h2>Ventas por vendedor</h2></div></div>@if (Model.SalesBySeller.Count == 0) { <p class="subtle">Sin ventas en el período.</p> }<div class="table-wrap"><table><thead><tr><th>Vendedor</th><th>Pedidos</th><th>Monto</th></tr></thead><tbody>@foreach (var row in Model.SalesBySeller) { <tr><td>@row.Seller</td><td>@row.Count</td><td>@row.Total.ToString("C0", money)</td></tr> }</tbody></table></div></section></div>
<div class="report-columns"><section class="panel"><div class="panel-title"><div><p class="eyebrow">EMBUDO</p><h2>Oportunidades por etapa</h2></div></div><div class="table-wrap"><table><thead><tr><th>Etapa actual</th><th>Cantidad</th><th>Importe estimado</th></tr></thead><tbody>@foreach (var row in Model.ByStage) { <tr><td>@OpportunitiesController.StageLabel(row.Stage)</td><td>@row.Count</td><td>@row.Total.ToString("C0", money)</td></tr> }</tbody></table></div></section>
<section class="panel"><div class="panel-title"><div><p class="eyebrow">APRENDIZAJE</p><h2>Motivos de pérdida</h2></div></div>@if (Model.LostReasons.Count == 0) { <p class="subtle">No hay oportunidades perdidas en la cohorte.</p> }<div class="table-wrap"><table><thead><tr><th>Motivo</th><th>Cantidad</th></tr></thead><tbody>@foreach (var row in Model.LostReasons) { <tr><td>@row.Reason</td><td>@row.Count</td></tr> }</tbody></table></div><p class="report-small">Las oportunidades perdidas antes de esta etapa pueden aparecer como «Sin registrar».</p></section></div>
<div class="report-columns"><section class="panel"><div class="panel-title"><div><p class="eyebrow">SEGUIMIENTO ACTUAL</p><h2>Actividades</h2></div><a class="text-link" asp-controller="Activities" asp-action="Index">Ver listado</a></div><div class="report-status"><div><strong>@Model.PendingCount</strong><span>pendientes</span></div><div class="danger"><strong>@Model.OverdueCount</strong><span>vencidas</span></div></div></section>
<section class="panel"><div class="panel-title"><div><p class="eyebrow">ATENCIÓN COMERCIAL</p><h2>Clientes sin contacto reciente</h2></div><strong>@Model.InactiveCustomers.Count</strong></div><p class="report-small">Sin contacto durante 30 días o más; incluye clientes nunca contactados cuya ficha ya tiene esa antigüedad.</p>@if (Model.InactiveCustomers.Count == 0) { <p class="subtle">No hay clientes para revisar.</p> }<div class="report-customer-list">@foreach (var customer in Model.InactiveCustomers.Take(20)) { <div><a asp-controller="Customers" asp-action="Details" asp-route-id="@customer.Id">@customer.Name</a><span>@(customer.LastContactAtUtc.HasValue ? ActivitySchedule.ToLocal(customer.LastContactAtUtc.Value).ToString("dd/MM/yyyy") : "Nunca")</span></div> }</div>@if (Model.InactiveCustomers.Count > 20) { <p class="report-small">Se muestran 20; descargá el CSV para verlos todos.</p> }</section></div>
<p class="report-note">El tiempo medio de cierre solo incluye oportunidades ganadas con fecha de cierre registrada desde esta actualización; Nexo no infiere fechas históricas.</p>
