@model OrderListVm
@{ ViewData["Title"] = "Pedidos"; var canEdit = !User.IsInRole(AppRoles.Viewer); }
<section class="page-heading"><div><p class="eyebrow">OPERACIONES</p><h1>Todos los pedidos</h1><p class="subtle">Buscá por número, descripción o cliente.</p></div></section>
<form method="get" class="filters"><label class="search"><span aria-hidden="true">⌕</span><input name="query" value="@Model.Query" placeholder="Buscar pedido o cliente" /></label><select name="status"><option value="">Todos los estados</option>@foreach (var status in Enum.GetValues<OrderStatus>()) { <option value="@status" selected="@(Model.Status == status)">@OrdersController.StatusLabel(status)</option> }</select><button class="button button-secondary">Filtrar</button><a class="text-link" asp-action="Index">Limpiar</a></form>
<div class="panel table-wrap"><table><thead><tr><th>Pedido</th><th>Cliente</th><th>Fecha</th><th>Estado</th><th class="amount">Monto</th>@if (canEdit) { <th>Acciones</th> }</tr></thead><tbody>@foreach (var order in Model.Orders) { <tr><td><strong>@order.Number</strong><small>@order.Description</small></td><td><a class="text-link" asp-controller="Customers" asp-action="Details" asp-route-id="@order.CustomerId">@order.Customer.Name</a></td><td>@order.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</td><td><span class="status status-@order.Status.ToString().ToLowerInvariant()">@OrdersController.StatusLabel(order.Status)</span></td><td class="amount">@order.Total.ToString("C0", new System.Globalization.CultureInfo("es-AR"))</td>@if (canEdit) { <td><form class="inline-form status-form" asp-action="ChangeStatus" method="post"><input type="hidden" name="id" value="@order.Id" /><input type="hidden" name="returnTo" value="orders" /><label class="sr-only" for="status-@order.Id">Nuevo estado de @order.Number</label><select id="status-@order.Id" name="status">@foreach (var status in Enum.GetValues<OrderStatus>()) { <option value="@status" selected="@(status == order.Status)">@OrdersController.StatusLabel(status)</option> }</select><button class="button button-small" type="submit">Actualizar</button></form></td> }</tr> }</tbody></table></div>
<partial name="_Pagination" model="@(new PaginationVm(Model.Page, Model.TotalPages, Model.Query, Model.Status))" />
