@model Order
@{ ViewData["Title"] = "Nuevo pedido"; }
<div class="narrow">
    <a class="back" asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">← Volver a @ViewBag.CustomerName</a>
    <div class="form-card">
        <p class="eyebrow">PEDIDO PARA @ViewBag.CustomerName</p><h1>Nuevo pedido</h1>
        <form asp-action="Create" method="post">
            <input asp-for="CustomerId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation"></div>
            <div class="field-row"><div class="field"><label asp-for="Number"></label><input asp-for="Number" /></div><div class="field"><label asp-for="Total"></label><input asp-for="Total" inputmode="decimal" placeholder="0,00" /></div></div>
            <div class="field"><label asp-for="Description"></label><textarea asp-for="Description" rows="4"></textarea><span asp-validation-for="Description"></span></div>
            <div class="field"><label asp-for="Status"></label><select asp-for="Status">@foreach (var status in Enum.GetValues<OrderStatus>()) { <option value="@status">@OrdersController.StatusLabel(status)</option> }</select></div>
            <div class="form-actions"><a class="button button-secondary" asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">Cancelar</a><button class="button" type="submit">Crear pedido</button></div>
        </form>
    </div>
</div>
